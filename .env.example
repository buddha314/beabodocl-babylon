# Backend API Configuration
# =========================
# The frontend needs to know where the backend API is located.
# This can be:
# - Local: http://localhost:8000 (default)
# - Network: http://192.168.1.200:8000 (backend on another computer)
# - Remote: http://your-server.com:8000 (backend on a remote server)

# IMPORTANT for VR Headset Access:
# If VR headsets will connect to this app over your local network,
# make sure this URL uses an IP address that's accessible from the headsets.
# Using 'localhost' will NOT work from VR headsets!

NEXT_PUBLIC_API_URL=http://localhost:8000

# Development Server Configuration
# =================================
# Port for the Next.js development server
# Default is 3000, but you can change it if needed

# PORT=3000

# Network Configuration Notes
# ============================
# 
# Scenario 1: Everything on one computer
# - Backend: http://localhost:8000
# - Frontend: http://localhost:3000
# - VR Access: http://<your-computer-ip>:3000
# 
# Scenario 2: Backend on separate computer
# - Backend: http://192.168.1.200:8000 (replace with backend computer's IP)
# - Frontend: http://localhost:3000 (on this computer)
# - VR Access: http://<this-computer-ip>:3000
#
# Scenario 3: Multiple VR users on network
# - All users connect to: http://<frontend-computer-ip>:3000
# - Backend can be on any network-accessible computer
#
# To find your computer's IP address:
# - Windows: Run 'ipconfig' in PowerShell/CMD
# - Mac/Linux: Run 'ifconfig' or 'ip addr' in terminal
# - Look for IPv4 address (e.g., 192.168.1.x or 10.0.0.x)
